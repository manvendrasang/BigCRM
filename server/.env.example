# BigCRM -- example configuration
#
# Copy to .env and set every REQUIRED value. This file documents every variable;
# it contains no real secrets and must never hold any.
#
# Configuration FAILS CLOSED. Startup aborts on a missing, placeholder, short, or
# duplicated secret; on an empty APP_ORIGINS in production; on a console email
# provider in production; and on a missing DATABASE_URL in production.
# See docs/ARCHITECTURE.md and docs/DEPLOYMENT.md.

# 
# Runtime
# 
# NODE_ENV deliberately controls NOTHING security-relevant. CSP, CORS, logging
# and deployment mode each have their own variable below (RULE 208).
NODE_ENV=development
ENV_NAME=local
LOG_LEVEL=debug # debug | info | warn | error | silent
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000

# 
# CORS / CSRF
# 
# REQUIRED in production, and must be non-empty: an empty allowlist must never
# mean "allow every origin" (RULE 37). Comma-separated. https only in production.
#
# Must include the origin the BROWSER loads the SPA from, not just the API. In
# local dev `npm run dev:web` serves the client on 5173 and proxies /api to the
# API on 3000, so the browser sends `Origin: http://localhost:5173`. Omitting it
# makes every auth request fail 403 "Cross-origin request rejected" -- including
# register and login -- because csrfGuard validates Origin against this list.
APP_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_MAX_AGE_SEC=600

# 
# Database
# 
# Either DATABASE_URL (production, node-postgres) or PGLITE_DATA_DIR
# (development/test, real PostgreSQL 17 in WASM). DATABASE_URL is REQUIRED in
# production -- embedded Postgres is a dev/test convenience only.
#
# PGLITE_DATA_DIR=memory ephemeral, one process
# PGLITE_DATA_DIR=.pgdata persisted
# DATABASE_URL=postgresql://user:pass@host:5432/bigcrm?sslmode=require
PGLITE_DATA_DIR=memory

DB_POOL_MAX=10

#  TLS to the database (RULE 52) 
# `disable` no TLS. Refused in production.
# `require` TLS with any certificate accepted. Stops a passive observer,
# NOT an active man-in-the-middle. Private link / tunnel only.
# `verify-full` TLS plus chain validation and hostname match. This is the
# production default.
DATABASE_SSL=disable

# Amazon RDS issues certificates from Amazon's PRIVATE CA, which is not in the
# public root store. Without this, a verify-full connection falls back to the
# system trust store and fails. Supply one of:
# DATABASE_SSL_CA_FILE -- path, e.g. a mounted rds-global-bundle.pem. Read at
# startup, so a missing mount fails fast and clearly.
# DATABASE_SSL_CA -- inline PEM.
# Leave both unset only when the issuer is already publicly trusted.
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem
# DATABASE_SSL_CA=
DB_STATEMENT_TIMEOUT_MS=15000

# 
# Secrets -- REQUIRED
# 
# Generate each independently: openssl rand -base64 48
# Minimum 32 characters. All three MUST differ from one another. Placeholder-like
# values are rejected in production.
#
# SECRETS_PEPPER is mixed into every password hash. It cannot be rotated without
# invalidating stored passwords -- see docs/INCIDENT_RESPONSE.md §5.
JWT_ISSUER=bigcrm.local
JWT_AUDIENCE=bigcrm.local.api
JWT_ACCESS_SECRET=replace_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_me_refresh_secret_min_32_chars
SECRETS_PEPPER=replace_me_pepper_min_32_chars
STORAGE_SIGNING_SECRET=replace_me_storage_secret_min_32_chars

# 
# Field encryption (MFA secrets) -- env keys by default, KMS when configured
# 
# MFA_KEY_PROVIDER=env derive the field key from SECRETS_PEPPER (default).
# MFA_KEY_PROVIDER=kms decrypt the data key below via KMS once at startup.
# The wire format is identical under both, but existing rows were sealed under
# the old key -- switching providers orphans them like a pepper rotation would.
#MFA_KEY_PROVIDER=env
# Base64 of the KMS-encrypted 32-byte data key. Required when the provider is
# kms. Region/endpoint flow through the SDK's AWS_REGION / AWS_ENDPOINT_URL.
#KMS_MFA_KEY_CIPHERTEXT=
#
# Local KMS with no AWS account (LocalStack):
# docker compose --profile kms up -d kms
# export AWS_REGION=us-east-1 AWS_ENDPOINT_URL=http://localhost:4566
# aws kms create-key --description bigcrm-mfa
# aws kms generate-data-key --key-id <key-id> --key-spec AES_256 \
# --query Plaintext --output text | base64 -d > /tmp/mfa-plain.bin
# aws kms encrypt --key-id <key-id> \
# --plaintext fileb:///tmp/mfa-plain.bin --query CiphertextBlob \
# --output text # -> paste into KMS_MFA_KEY_CIPHERTEXT
# shred -u /tmp/mfa-plain.bin
# The LocalStack key is throwaway dev material; production uses a real CMR
# with rotation, and the ciphertext above is safe to store (it needs KMS to
# open).

# 
# Tokens & sessions
# 
JWT_ACCESS_TTL_SEC=900 # 15 minutes. Short access tokens are the point.
JWT_REFRESH_TTL_SEC=604800 # 7 days, rotating and single-use
JWT_REFRESH_IDLE_SEC=2592000 # 30 days absolute cap on a session family
JWT_COOKIE_NAME=bigcrm_at
CSRF_COOKIE_NAME=bigcrm_csrf

SESSION_IDLE_TIMEOUT_SEC=3600 # 1 hour idle
SESSION_ABSOLUTE_TIMEOUT_SEC=43200 # 12 hours regardless of activity
SESSION_MAX_PER_USER=20

# 
# Cookies
# 
# COOKIES_SECURE must be true in production (HTTPS only).
COOKIES_SECURE=false
COOKIES_SAMESITE=lax # lax | strict | none

# 
# Passwords
# 
# scrypt is the default: Node built-in, no native dependency. argon2id is
# preferred by OWASP and is validated with a self-test on first use -- if the
# native binding cannot verify, startup fails loudly rather than trusting it.
# PARAM INCREASE_NOTE: raise SCRYPT_N_LOG2 in lib/password.ts per deployment tier;
# needsRehash() upgrades stored hashes transparently on next login.
PASSWORD_ALGORITHM=scrypt # scrypt | argon2id
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256

# 
# Security posture
# 
HSTS_ENABLED=false # true in production, only after TLS is confirmed
HSTS_MAX_AGE_SEC=31536000
CSP_REPORT_ONLY=false
BLOCK_NEW_ACCOUNTS=true # self-service signup closed by default; members are created in-house under Settings > Members
REQUIRE_MFA_FOR_PRIVILEGED=false
MAX_FAILED_LOGINS=10
LOCKOUT_SEC=900
TRUST_PROXY_HOPS=0 # 1 behind an ALB; must equal the real hop count

# 
# Rate limits
# 
# Not IP-only: auth is limited per IP AND per account (RULE 67).
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_UPLOAD_MAX=20

# 
# Email
# 
# The console provider refuses to run when NODE_ENV=production: a console logger
# is not email delivery (RULE 197). Production must supply a real transport,
# and SMTP_URL is where the provider interface expects it.
EMAIL_PROVIDER=console # console | smtp
EMAIL_FROM=no-reply@bigcrm.local
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# 
# MongoDB Atlas -- REMOVED 2026-10-11
# 
# PostgreSQL 17 is the only database this service uses. The Atlas integration was
# implemented (URI validation, credential redaction, 24 assertions) but never
# connected to a live cluster, and it was decided against as the system of record:
# the schema needs 89 foreign keys, 53 CHECK constraints, a composite FK and an
# append-only trigger, none of which a document store enforces.
#
# The provider is preserved as commented source in src/integrations/mongodb.ts,
# excluded from tsconfig, and its package dependency removed. The `atlas:ping`
# CLI command and the MONGODB_* variables below no longer exist. See
# docs/ARCHITECTURE.md and docs/PROJECT_STATUS.md.
# 

# Required only by `npm run seed`. Must be >= 12 characters or seeding refuses
# to run (cli.ts). Leave empty to skip seeding entirely.
SEED_OWNER_PASSWORD=
# Object keys are always organizations/{orgId}/documents/{uuid}{ext} -- opaque,
# never derived from a user-supplied filename.
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_DIR=.bigcrm-storage
# STORAGE_BUCKET=bigcrm-files
# AWS_REGION=us-east-1
STORAGE_PRESIGN_TTL_SEC=300 # 5 minutes maximum
MAX_UPLOAD_BYTES=26214400 # 25 MiB

# 
# Observability
# 
METRICS_ENABLED=true
METRICS_PATH=/internal/metrics # bind to a private network, or authenticate it

# 
# Retention
# 
# Destructive. Keep RETENTION_PURGE_ENABLED=false until legal hold exists --
# see docs/DISASTER_RECOVERY.md §6.
RETENTION_AUDIT_DAYS=730
RETENTION_SESSION_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_EXPORT_DAYS=7
RETENTION_PURGE_ENABLED=false

# 
# Body limit
# 
BODY_LIMIT_BYTES=1048576 # 1 MiB