{
  "name": "@bigcrm/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --env-file=.env --watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node --experimental-strip-types --no-warnings --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types --no-warnings --env-file=.env src/db/cli.ts migrate:up",
    "seed": "node --experimental-strip-types --no-warnings --env-file=.env src/db/cli.ts seed",
    "rekey": "node --experimental-strip-types --no-warnings --env-file=.env src/db/cli.ts rekey",
    "test": "node --experimental-strip-types --no-warnings --env-file=.env.test src/tests/run.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reports-dir=./coverage --check-coverage --lines 85 --functions 75 --branches 70 --statements 85 node --experimental-strip-types --no-warnings --env-file=.env.test src/tests/run.ts",
    "test:security": "node --experimental-strip-types --no-warnings --env-file=.env.test src/tests/security/scenarios.test.ts",
    "migrate:status": "node --experimental-strip-types --no-warnings src/db/cli.ts migrate:status",
    "atlas:ping": "node --experimental-strip-types --no-warnings src/db/cli.ts atlas:ping"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1151.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "c8": "^12.0.0",
    "typescript": "^5.9.3"
  }
}
